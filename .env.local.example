# ============================================================
# Copy this file, rename the copy to .env.local, and fill in
# every value below. Never commit .env.local to GitHub.
# ============================================================

# ---- Supabase (database) ----
# Find these in Supabase: Project Settings -> Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (image storage) ----
# Find these on your Cloudinary Dashboard homepage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
